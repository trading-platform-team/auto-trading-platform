# 이 파일을 복사해서 .env 로 만든 뒤 값을 채우세요. (.env는 커밋 금지)

# 키움 REST API (모의투자) — 키 원문은 .env에만. 커밋·채팅·단톡방 금지
KIWOOM_APP_KEY=
KIWOOM_SECRET_KEY=
KIWOOM_BASE_URL=https://mockapi.kiwoom.com

# 시세 소스: mock(가상 시세) | kiwoom(위 키로 키움 실시간 시세)
MARKET_SOURCE=mock

# 사용자 키 등록 기능이 생기기 전까지, 실거래 메뉴(모의 서버)에서 모든 사용자가 위 팀 모의 키로 주문
KIWOOM_DEV_USE_TEAM_KEY=false
# REST 초당 호출 수, 실시간 구독 종목 상한 (공식 한도 확인 후 조정)
KIWOOM_REST_PER_SEC=4
KIWOOM_MAX_REALTIME=100

# Kafka / Redis
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
REDIS_URL=redis://redis:6379/0

# PostgreSQL
POSTGRES_USER=trader
POSTGRES_PASSWORD=change-me
POSTGRES_DB=trading
DATABASE_URL=postgresql://trader:change-me@postgres:5432/trading

# Vault (개발 모드 전용 토큰). JWT 서명 키는 Vault secret/trading 에 자동 생성·보관
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=dev-root-token

# Vault에 연결할 수 없을 때만 쓰는 JWT 서명 키 (비워 두면 임시 키)
JWT_SECRET=

# 타임머신 주요 사건 수집 (실제 값은 .env에만 입력)
OPENDART_API_KEY=
NAVER_NEWS_CLIENT_ID=
NAVER_NEWS_CLIENT_SECRET=
