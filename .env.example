# 이 파일을 복사해서 .env 로 만든 뒤 값을 채우세요. (.env는 커밋 금지)

# 키움 REST API (모의투자)
KIWOOM_APP_KEY=
KIWOOM_SECRET_KEY=
KIWOOM_BASE_URL=https://mockapi.kiwoom.com

# Kafka / Redis
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
REDIS_URL=redis://redis:6379/0

# PostgreSQL
POSTGRES_USER=trader
POSTGRES_PASSWORD=change-me
POSTGRES_DB=trading
DATABASE_URL=postgresql://trader:change-me@postgres:5432/trading

# Vault (개발 모드 전용 토큰)
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=dev-root-token
